# ============================
# RAG 金融政策问答系统 — 环境变量配置
# 复制此文件为 .env 后填入真实值
# ============================

# === 应用设置 ===
APP_ENV=development
PROJECT_NAME="retrieval-augmented-generation"
VERSION=1.0.0
DEBUG=true
API_V1_STR=/api/v1

# === CORS ===
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# === JWT 认证 ===
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# === PostgreSQL（与 docker-compose 中 POSTGRES_USER/PASSWORD/DB 保持一致）===
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/rag_db"
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=1

# === Milvus 向量数据库 ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default

# === Chat 模型（对话 / 决策）===
# 支持 OpenAI 兼容接口：DeepSeek、阿里云 DashScope、OpenAI 等
CHAT_MODEL=your_chat_model_name
CHAT_API_KEY=your_chat_api_key
CHAT_BASE_URL=your_chat_model_url

# === Embedding 模型（文本向量化）===
# 注意：当前代码使用 DashScope Embeddings，必须用阿里云
EMBEDDING_MODEL=your_embedding_model_name
EMBEDDING_API_KEY=your_embedding_api_key

# === LLM 通用设置 ===
DEFAULT_LLM_TEMPERATURE=0.2

# === 日志 ===
LOG_LEVEL=DEBUG
LOG_FORMAT=console
